# Student Academic Progress Tracking System (SAPTS)
# Apache configuration for local hosting under XAMPP.

# The sign-in page is the entry point; index.html redirects there anyway.
DirectoryIndex index.html login.html

# Basic hardening — mirrors what a production host would send.
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
</IfModule>

# Correct MIME types for the bundled assets.
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Keep the browser from caching the application files during a demo,
# so a refresh always shows the current build.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Never expose dotfiles, and never serve the SQL schema over HTTP: it contains
# the seeded password hashes and the table structure.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(sql|md)$">
    Require all denied
  </FilesMatch>
</IfModule>

# PHP must never be served as plain text, whatever the server configuration.
<IfModule mod_php.c>
  php_flag display_errors Off
</IfModule>
<FilesMatch "\.php$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store"
  </IfModule>
</FilesMatch>
